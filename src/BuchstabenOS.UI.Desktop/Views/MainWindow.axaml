<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BuchstabenOS.UI.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        x:Class="BuchstabenOS.UI.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BuchstabenOS"
        Background="#121316"
        Foreground="#F5F4EE"
        Focusable="True">

    <Grid>
        <!-- ========================================================= -->
        <!-- BÜHNE 1: SPIELBEREICH (KIND-PERSPEKTIVE)                  -->
        <!-- ========================================================= -->
        <Grid RowDefinitions="*,Auto,*" Margin="40">
            
            <!-- OBERER BEREICH: Schwebende, nach oben verblassende Historie-Zeilen -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding FloatingHistoryLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryLineItem">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="{Binding FontSize}"
                                       Opacity="{Binding Opacity}"
                                       Foreground="#E5E4DC"
                                       FontWeight="Medium"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- BILDSCHIRMMITTE: Die aktive Schreibzeile in voller Pracht -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Sanfter Hinweis für den Start (nur sichtbar wenn weder Text noch Vorlage aktiv) -->
                <TextBlock Text="{Binding ChildHint}"
                           FontSize="34"
                           Foreground="#424652"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!DisplayText.Length" />
                            <Binding Path="!IsTemplateChallengeActive" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Die getippten Buchstaben / Matheaufgabe im freien Modus -->
                <TextBlock Text="{Binding DisplayText}"
                           FontSize="{Binding FontSize}"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !IsTemplateChallengeActive}"
                           Classes.celebrating="{Binding IsWordCelebrationActive}"
                           Classes.wrong="{Binding IsWrongFeedbackActive}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="#F5F4EE" />
                        </Style>
                        <Style Selector="TextBlock.celebrating">
                            <Setter Property="Foreground" Value="#FFD166" />
                        </Style>
                        <Style Selector="TextBlock.wrong">
                            <Setter Property="Foreground" Value="#FF5C5C" />
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>

                <!-- INTERAKTIVE WORTVORLAGE (Lern-Impuls: Kontur vs. Ausgefüllt) -->
                <StackPanel Spacing="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsTemplateChallengeActive}">

                    <!-- Kleiner erklärender Hinweis über den Karten -->
                    <Border Background="#1C1E2A"
                            BorderBrush="#2F3348"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="18,7"
                            HorizontalAlignment="Center">
                        <TextBlock Text="✨ Zauberwort-Aufgabe: Tippe die Buchstaben ab (Leertaste = Überspringen)"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#9BA0B8" />
                    </Border>

                    <!-- Buchstabenkarten-Reihe -->
                    <ItemsControl ItemsSource="{Binding TemplateLetters}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TemplateLetterItem">
                                <Border CornerRadius="20"
                                        MinWidth="105" MinHeight="135"
                                        Padding="16,8"
                                        BorderThickness="3.5"
                                        Classes.filled="{Binding IsFilled}"
                                        Classes.current="{Binding IsCurrentTarget}"
                                        Classes.wrong="{Binding IsWrong}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Styles>
                                        <!-- 1. Kontur / Unausgefüllt (Geister-Buchstabe) -->
                                        <Style Selector="Border">
                                            <Setter Property="Background" Value="#13141C" />
                                            <Setter Property="BorderBrush" Value="#2F3346" />
                                        </Style>
                                        <Style Selector="Border TextBlock">
                                            <Setter Property="Foreground" Value="#4A4F65" />
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Style>

                                        <!-- 2. Aktueller Zielfokus (Hier bist du!) -->
                                        <Style Selector="Border.current">
                                            <Setter Property="Background" Value="#1A2033" />
                                            <Setter Property="BorderBrush" Value="#4D79FF" />
                                        </Style>
                                        <Style Selector="Border.current TextBlock">
                                            <Setter Property="Foreground" Value="#7FA6FF" />
                                            <Setter Property="Opacity" Value="0.8" />
                                        </Style>

                                        <!-- 3. Ausgefüllt / Richtig getippt (Leuchtendes Gold / Weiß) -->
                                        <Style Selector="Border.filled">
                                            <Setter Property="Background" Value="#2D2513" />
                                            <Setter Property="BorderBrush" Value="#FFD166" />
                                        </Style>
                                        <Style Selector="Border.filled TextBlock">
                                            <Setter Property="Foreground" Value="#FFD166" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </Style>

                                        <!-- 4. Fehleingabe (Rotes Warnleuchten) -->
                                        <Style Selector="Border.wrong">
                                            <Setter Property="Background" Value="#381515" />
                                            <Setter Property="BorderBrush" Value="#FF5C5C" />
                                        </Style>
                                        <Style Selector="Border.wrong TextBlock">
                                            <Setter Property="Foreground" Value="#FF8888" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </Style>
                                    </Border.Styles>

                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Letter}"
                                                   FontSize="80"
                                                   FontWeight="ExtraBold"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- UNTERER BEREICH: Wort- / Mathe-Feier-Banner & Falsch-Feedback -->
            <Grid Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0">
                <!-- ERFOLG -->
                <Border Background="#2A2212"
                        BorderBrush="#FFD166"
                        BorderThickness="2"
                        CornerRadius="16"
                        Padding="24,12"
                        IsVisible="{Binding IsWordCelebrationActive}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="⭐" FontSize="30" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CelebratedWord}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#FFD166"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="⭐" FontSize="30" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- FEHLER / NOCHMAL PROBIEREN -->
                <Border Background="#2A1414"
                        BorderBrush="#FF5C5C"
                        BorderThickness="2"
                        CornerRadius="16"
                        Padding="24,12"
                        IsVisible="{Binding IsWrongFeedbackActive}">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="28" VerticalAlignment="Center" />
                        <TextBlock Text="Fast richtig! Probier es gleich nochmal."
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#FF8888"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- BÜHNE 2: ELTERN-PORTAL OVERLAY (VERSTECKTES MENÜ)        -->
        <!-- ========================================================= -->
        <Grid Background="#E60A0B0E"
              IsVisible="{Binding IsParentOverlayVisible}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- PIN EINGABE -->
            <Border Background="#1C1E26"
                    BorderBrush="#2E3242"
                    BorderThickness="2"
                    CornerRadius="20"
                    Padding="36"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !ParentMenu.IsAuthenticated}">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="🛡️ Eltern-Bereich"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#F5F4EE"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Bitte PIN eingeben (Standard: 1337)"
                                   FontSize="15"
                                   Foreground="#8C90A0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBox Text="{Binding ParentMenu.PinInput}"
                             PasswordChar="•"
                             FontSize="32"
                             TextAlignment="Center"
                             Background="#121318"
                             Foreground="#F5F4EE"
                             BorderBrush="#3D4255"
                             CornerRadius="10"
                             Padding="10"
                             MaxLength="8" />

                    <TextBlock Text="{Binding ParentMenu.PinErrorMessage}"
                               Foreground="#FF5C5C"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding ParentMenu.PinErrorMessage.Length}" />

                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Content="Abbrechen"
                                Command="{Binding ToggleParentOverlay}"
                                Background="#2A2C38"
                                Foreground="#F5F4EE"
                                CornerRadius="8"
                                Padding="16,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Content="Entsperren"
                                Command="{Binding ParentMenu.SubmitPinCommand}"
                                Background="#3A7AF0"
                                Foreground="White"
                                FontWeight="Bold"
                                CornerRadius="8"
                                Padding="16,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ELTERN DASHBOARD -->
            <Border Background="#1A1C24"
                    BorderBrush="#2E3242"
                    BorderThickness="2"
                    CornerRadius="20"
                    Padding="32,28,16,28"
                    Width="820"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ParentMenu.IsAuthenticated}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,0,24,0">
                    <StackPanel Spacing="24" Margin="0,0,6,0">
                        
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="⚙️ BuchstabenOS Eltern-Bereich"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#F5F4EE" />
                                <TextBlock Text="Konfiguration &amp; Systemverwaltung für Moritz' Lernumgebung"
                                           FontSize="13"
                                           Foreground="#8C90A0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕ Schließen"
                                    Command="{Binding ParentMenu.CloseMenuCommand}"
                                    Background="#2A2C38"
                                    Foreground="#F5F4EE"
                                    CornerRadius="8"
                                    Padding="14,8" />
                        </Grid>

                        <!-- Statusmeldung -->
                        <Border Background="#1C2E22"
                                BorderBrush="#2ECC71"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                IsVisible="{Binding ParentMenu.StatusNotification.Length}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="ℹ️" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ParentMenu.StatusNotification}"
                                           Foreground="#A8F0C0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- ========================================================= -->
                        <!-- 1. GRUNDLEGENDE EINSTELLUNGEN (Spiel-unabhängig)          -->
                        <!-- ========================================================= -->
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🛠️ Grundlegende Einstellungen"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFD166" />
                                <TextBlock Text="Spiel-unabhängige Systemeinstellungen für Audio &amp; Darstellung"
                                           FontSize="12"
                                           Foreground="#8C90A0" />
                            </StackPanel>

                            <!-- Lautstärke -->
                            <Grid ColumnDefinitions="150,*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Lautstärke:" VerticalAlignment="Center" Foreground="#C5C7D0" FontWeight="SemiBold" />
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding ParentMenu.Volume}"
                                        Margin="16,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ParentMenu.Volume, StringFormat='{}{0}%'}"
                                           VerticalAlignment="Center"
                                           Foreground="#F5F4EE"
                                           FontWeight="Bold"
                                           Width="45" />
                            </Grid>

                            <!-- Audio-Ausgabegerät (Ausblick) -->
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Audio-Ausgabe:" VerticalAlignment="Center" Foreground="#C5C7D0" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ParentMenu.AvailableAudioDevices}"
                                          SelectedItem="{Binding ParentMenu.SelectedAudioDevice}"
                                          HorizontalAlignment="Stretch"
                                          Background="#121318"
                                          Foreground="#F5F4EE"
                                          BorderBrush="#3D4255"
                                          CornerRadius="8"
                                          Padding="10,6" />
                            </Grid>

                            <!-- Design / Farbschema (Ausblick) -->
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Design / Stil:" VerticalAlignment="Center" Foreground="#C5C7D0" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ParentMenu.AvailableThemes}"
                                          SelectedItem="{Binding ParentMenu.SelectedTheme}"
                                          HorizontalAlignment="Stretch"
                                          Background="#121318"
                                          Foreground="#F5F4EE"
                                          BorderBrush="#3D4255"
                                          CornerRadius="8"
                                          Padding="10,6" />
                            </Grid>
                        </StackPanel>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- ========================================================= -->
                        <!-- 2. MODERATION (NUR Moderations-Einstellungen)            -->
                        <!-- ========================================================= -->
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🎲 Moderation"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFD166" />
                                <TextBlock Text="Steuerung von Spielwechseln und kindlicher Aufmerksamkeitsspanne"
                                           FontSize="12"
                                           Foreground="#8C90A0" />
                            </StackPanel>

                            <!-- Strategie-Auswahl -->
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Strategie:" VerticalAlignment="Center" Foreground="#C5C7D0" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ParentMenu.AvailableModerationStrategies}"
                                          SelectedItem="{Binding ParentMenu.SelectedModerationStrategy}"
                                          HorizontalAlignment="Stretch"
                                          Background="#121318"
                                          Foreground="#F5F4EE"
                                          BorderBrush="#3D4255"
                                          CornerRadius="8"
                                          Padding="10,6" />
                            </Grid>

                            <!-- Parameter: Zufallswürfel -->
                            <Border Background="#121318"
                                    BorderBrush="#2E3242"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    IsVisible="{Binding ParentMenu.IsDiceModeration}">
                                <StackPanel Spacing="14">
                                    <CheckBox IsChecked="{Binding ParentMenu.AutoGameSwitching}"
                                              Content="Automatischer Spielewechsel aktiv (Rotiert nach Aufmerksamkeitsspanne)"
                                              Foreground="#F5F4EE"
                                              FontWeight="SemiBold" />

                                    <TextBlock Text="Aufmerksamkeits-Grenzen: Wechselt nach 2 gelösten Mathe-Aufgaben bzw. 5 erkannten Wörtern (oder 5 Min.)."
                                               FontSize="12"
                                               Foreground="#8C90A0" />

                                    <Separator Background="#252834" Height="1" />

                                    <TextBlock Text="🎲 Würfel-Gewichtung bei automatischem Wechsel:"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#E5E4DC" />

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding ParentMenu.TypingWeight, StringFormat='Buchstaben-Zauber: {0}%'}" Foreground="#C5C7D0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding ParentMenu.TypingWeight}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ParentMenu.MathWeight, StringFormat='Mathe-Addition: {0}%'}" Foreground="#C5C7D0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding ParentMenu.MathWeight}" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="💾 Moderations-Einstellungen speichern"
                                            Command="{Binding ParentMenu.SaveModerationSettingsCommand}"
                                            Background="#2ECC71"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            CornerRadius="8"
                                            Padding="14,8"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>

                            <!-- Parameter: KI-Adaptive Steuerung (Zukunft / Vorschau) -->
                            <Border Background="#121318"
                                    BorderBrush="#3A7AF0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    IsVisible="{Binding !ParentMenu.IsDiceModeration}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🧠 KI-Adaptive Steuerung (In Vorbereitung)"
                                               FontWeight="Bold"
                                               Foreground="#85B7FF" />
                                    <TextBlock Text="Diese Moderations-Implementierung wird das Lerntempo, Fehlerquoten und Ermüdungsanzeichen von Moritz in Echtzeit auswerten und die Spielrunden vollautomatisch anpassen."
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="#A0A5B5" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- ========================================================= -->
                        <!-- 3. SPIELE (Akkordeon / Expander Liste)                   -->
                        <!-- ========================================================= -->
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🎮 Spiele"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFD166" />
                                <TextBlock Text="Liste der installierten Lernspiele mit individuellen Einstellungsbereichen"
                                           FontSize="12"
                                           Foreground="#8C90A0" />
                            </StackPanel>

                            <!-- SPIEL 1: BUCHSTABEN-ZAUBER (EXPANDER) -->
                            <Expander IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      Background="#14161E"
                                      BorderBrush="#2E3242"
                                      BorderThickness="1"
                                      CornerRadius="10">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,12,0">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="🔤 Buchstaben-Zauber"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#F5F4EE"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#1E4620"
                                                    BorderBrush="#2ECC71"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ParentMenu.IsFreeTypingActive}">
                                                <TextBlock Text="Aktiv" Foreground="#2ECC71" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="▶️ Jetzt spielen"
                                                Command="{Binding ParentMenu.SwitchActiveGameCommand}"
                                                CommandParameter="free-typing"
                                                IsVisible="{Binding !ParentMenu.IsFreeTypingActive}"
                                                Background="#3A7AF0"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                FontSize="12" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="14" Margin="14,8,14,14">
                                    <!-- Sprachmodus -->
                                    <TextBlock Text="Sprachausgabe beim Tastendruck:"
                                               FontWeight="SemiBold"
                                               Foreground="#C5C7D0" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0"
                                                Content="Lautieren (M, A, P)"
                                                Command="{Binding ParentMenu.SetSpeechModeCommand}"
                                                CommandParameter="Phonetic"
                                                Classes.active="{Binding ParentMenu.IsPhoneticSpeechMode}"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Margin="0,0,6,0">
                                            <Button.Styles>
                                                <Style Selector="Button.active">
                                                    <Setter Property="Background" Value="#3A7AF0" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Content="Alphabet (Em, Ah, Pe)"
                                                Command="{Binding ParentMenu.SetSpeechModeCommand}"
                                                CommandParameter="Alphabet"
                                                Classes.active="{Binding !ParentMenu.IsPhoneticSpeechMode}"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Margin="6,0,0,0">
                                            <Button.Styles>
                                                <Style Selector="Button.active">
                                                    <Setter Property="Background" Value="#3A7AF0" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </Grid>

                                    <Separator Background="#252834" Height="1" />

                                    <!-- Wörterbuch -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="📚 Wörterbuch (Erkannte Wörter)"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C5C7D0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ParentMenu.GameWords.Count, StringFormat='{}{0} Wörter'}"
                                                   Foreground="#8C90A0"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Neues Wort hinzufügen -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding ParentMenu.NewWordInput}"
                                                 Watermark="Neues Wort eingeben (z.B. BAGGER, OMA, REX)..."
                                                 Background="#121318"
                                                 Foreground="#F5F4EE"
                                                 BorderBrush="#3D4255"
                                                 CornerRadius="8"
                                                 Padding="10,8"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Content="+ Hinzufügen"
                                                Command="{Binding ParentMenu.AddWordCommand}"
                                                Background="#2ECC71"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                CornerRadius="8"
                                                Padding="16,8" />
                                    </Grid>

                                    <!-- Wortliste als Tags -->
                                    <Border Background="#121318"
                                            BorderBrush="#252834"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            MaxHeight="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ParentMenu.GameWords}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#222530"
                                                                CornerRadius="6"
                                                                Padding="8,4"
                                                                Margin="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding}" Foreground="#F5F4EE" VerticalAlignment="Center" />
                                                                <Button Content="✕"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ParentMenu.RemoveWordCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        Foreground="#FF7B7B"
                                                                        Padding="2,0"
                                                                        FontSize="11" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <Separator Background="#252834" Height="1" />

                                    <!-- Wortvorlagen (Lern-Impulse) Einstellungen -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="✨ Wortvorlagen (Lern-Impulse)"
                                                       FontWeight="SemiBold"
                                                       Foreground="#C5C7D0" />
                                            <TextBlock Text="Blendet in unregelmäßigen Abständen Wort-Konturen zum Nach-Tippen ein"
                                                       FontSize="11"
                                                       Foreground="#8C90A0" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding ParentMenu.WordTemplatesEnabled}"
                                                      OnContent="An"
                                                      OffContent="Aus" />
                                    </Grid>

                                    <!-- Häufigkeit der Einblendung (wenn aktiv) -->
                                    <StackPanel Spacing="6" IsVisible="{Binding ParentMenu.WordTemplatesEnabled}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="Häufigkeit der Einblendungen:"
                                                       FontSize="12"
                                                       Foreground="#A5A8B8" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ParentMenu.WordTemplateInterval, StringFormat='{}ca. alle {0} Tasten'}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#FFD166" />
                                        </Grid>
                                        <Slider Minimum="10"
                                                Maximum="50"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding ParentMenu.WordTemplateInterval}" />
                                    </StackPanel>

                                    <Button Content="💾 Buchstabenzauber-Einstellungen speichern"
                                            Command="{Binding ParentMenu.SaveTypingSettingsCommand}"
                                            Background="#2A2C38"
                                            Foreground="#FFD166"
                                            FontWeight="SemiBold"
                                            CornerRadius="8"
                                            Padding="14,8"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Expander>

                            <!-- SPIEL 2: MATHESPIEL ADDITION (EXPANDER) -->
                            <Expander IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      Background="#14161E"
                                      BorderBrush="#2E3242"
                                      BorderThickness="1"
                                      CornerRadius="10">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,12,0">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="➕ Mathespiel Addition"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#F5F4EE"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#1E4620"
                                                    BorderBrush="#2ECC71"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ParentMenu.IsMathAdditionActive}">
                                                <TextBlock Text="Aktiv" Foreground="#2ECC71" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="▶️ Jetzt spielen"
                                                Command="{Binding ParentMenu.SwitchActiveGameCommand}"
                                                CommandParameter="math-addition"
                                                IsVisible="{Binding !ParentMenu.IsMathAdditionActive}"
                                                Background="#3A7AF0"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                FontSize="12" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="14" Margin="14,8,14,14">
                                    <TextBlock Text="Zahlenraum-Einstellung:"
                                               FontWeight="SemiBold"
                                               Foreground="#C5C7D0" />

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Rechnen bis: " Foreground="#8C90A0" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Minimum="2"
                                                Maximum="20"
                                                Value="{Binding ParentMenu.MathMaxSum}"
                                                Margin="16,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ParentMenu.MathMaxSum, StringFormat='bis {0}'}"
                                                   Foreground="#FFD166"
                                                   FontWeight="Bold"
                                                   Width="50"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Button Content="💾 Mathe-Einstellungen speichern"
                                            Command="{Binding ParentMenu.SaveMathSettingsCommand}"
                                            Background="#2ECC71"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            CornerRadius="8"
                                            Padding="14,8"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- ========================================================= -->
                        <!-- 4. SYSTEMEINSTELLUNGEN (Linux-Systemaktionen)             -->
                        <!-- ========================================================= -->
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="💻 Systemeinstellungen (Linux)"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFD166" />
                                <TextBlock Text="Systemsteuerungs-Aktionen &amp; Software-Updates für Moritz' Laptop"
                                           FontSize="12"
                                           Foreground="#8C90A0" />
                            </StackPanel>

                            <!-- SOFTWARE-UPDATES CARD -->
                            <Border Background="#161822"
                                    BorderBrush="#2E3242"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,4,0,4">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="🚀 Software-Updates"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           Foreground="#F5F4EE"
                                                           VerticalAlignment="Center" />
                                                <Border Background="#252836"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ParentMenu.CurrentVersion, StringFormat='v{0}'}"
                                                               Foreground="#8C90A0"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ParentMenu.UpdateStatusText}"
                                                       FontSize="13"
                                                       Foreground="#A5A8B8" />
                                        </StackPanel>

                                        <!-- Aktions-Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Nach Updates suchen -->
                                            <Button Content="🔍 Nach Updates suchen"
                                                    Command="{Binding ParentMenu.CheckForUpdatesCommand}"
                                                    IsVisible="{Binding !ParentMenu.IsCheckingForUpdates}"
                                                    Background="#2A2C38"
                                                    Foreground="#F5F4EE"
                                                    CornerRadius="8"
                                                    Padding="14,9" />

                                            <TextBlock Text="⏳ Prüfe Updates..."
                                                       IsVisible="{Binding ParentMenu.IsCheckingForUpdates}"
                                                       Foreground="#FFD166"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />

                                            <!-- Jetzt installieren -->
                                            <Button Content="⬇️ Jetzt installieren"
                                                    Command="{Binding ParentMenu.InstallUpdateCommand}"
                                                    IsVisible="{Binding ParentMenu.IsUpdateAvailable}"
                                                    IsEnabled="{Binding !ParentMenu.IsDownloadingUpdate}"
                                                    Background="#2ECC71"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    CornerRadius="8"
                                                    Padding="14,9" />

                                            <!-- Jetzt neu starten -->
                                            <Button Content="🔄 Jetzt neu starten"
                                                    Command="{Binding ParentMenu.RestartAppCommand}"
                                                    IsVisible="{Binding ParentMenu.IsUpdateReadyToRestart}"
                                                    Background="#FFD166"
                                                    Foreground="#121318"
                                                    FontWeight="Bold"
                                                    CornerRadius="8"
                                                    Padding="14,9" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fortschrittsbalken beim Download -->
                                    <StackPanel Spacing="4" IsVisible="{Binding ParentMenu.IsDownloadingUpdate}">
                                        <ProgressBar Value="{Binding ParentMenu.DownloadProgressPercent}"
                                                     Minimum="0" Maximum="100"
                                                     Height="8"
                                                     CornerRadius="4"
                                                     Foreground="#2ECC71"
                                                     Background="#101116" />
                                    </StackPanel>

                                    <!-- Fehlermeldung falls aufgetreten -->
                                    <TextBlock Text="{Binding ParentMenu.UpdateErrorMessage}"
                                               Foreground="#FF7B7B"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding ParentMenu.UpdateErrorMessage.Length}" />

                                    <!-- Changelog-Vorschau falls Update verfügbar -->
                                    <Expander Header="📋 Was ist neu in diesem Update?"
                                              IsVisible="{Binding ParentMenu.IsUpdateAvailable}"
                                              Background="#101116"
                                              BorderBrush="#252834"
                                              BorderThickness="1"
                                              CornerRadius="8">
                                        <ScrollViewer MaxHeight="120">
                                            <TextBlock Text="{Binding ParentMenu.UpdateChangelog}"
                                                       Foreground="#C5C7D0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="12,8" />
                                        </ScrollViewer>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*,*">
                                <Button Grid.Column="0"
                                        Content="🖥️ Desktop freigeben"
                                        Command="{Binding ParentMenu.ExitToDesktopCommand}"
                                        Background="#2A2C38"
                                        Foreground="#F5F4EE"
                                        CornerRadius="8"
                                        Padding="12,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Content="🔄 Laptop Neustarten"
                                        Command="{Binding ParentMenu.RebootCommand}"
                                        Background="#2A2C38"
                                        Foreground="#F5F4EE"
                                        CornerRadius="8"
                                        Padding="12,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="6,0,6,0" />
                                <Button Grid.Column="2"
                                        Content="⏻ Laptop Ausschalten"
                                        Command="{Binding ParentMenu.PowerOffCommand}"
                                        Background="#C0392B"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        CornerRadius="8"
                                        Padding="12,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
