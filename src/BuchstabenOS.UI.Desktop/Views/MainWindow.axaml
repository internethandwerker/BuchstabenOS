<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BuchstabenOS.UI.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        x:Class="BuchstabenOS.UI.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BuchstabenOS"
        Background="#121316"
        Foreground="#F5F4EE"
        Focusable="True">

    <Grid>
        <!-- ========================================================= -->
        <!-- BÜHNE 1: SPIELBEREICH (KIND-PERSPEKTIVE)                  -->
        <!-- ========================================================= -->
        <Grid RowDefinitions="*,Auto,*" Margin="40">
            
            <!-- OBERER BEREICH: Schwebende, nach oben verblassende Historie-Zeilen -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding FloatingHistoryLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryLineItem">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="{Binding FontSize}"
                                       Opacity="{Binding Opacity}"
                                       Foreground="#E5E4DC"
                                       FontWeight="Medium"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- BILDSCHIRMMITTE: Die aktive Schreibzeile in voller Pracht -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Sanfter Hinweis für den Start -->
                <TextBlock Text="{Binding ChildHint}"
                           FontSize="34"
                           Foreground="#424652"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !DisplayText.Length}" />

                <!-- Die getippten Buchstaben / Matheaufgabe in der Bildschirmmitte -->
                <TextBlock Text="{Binding DisplayText}"
                           FontSize="{Binding FontSize}"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Classes.celebrating="{Binding IsWordCelebrationActive}"
                           Classes.wrong="{Binding IsWrongFeedbackActive}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="#F5F4EE" />
                        </Style>
                        <Style Selector="TextBlock.celebrating">
                            <Setter Property="Foreground" Value="#FFD166" />
                        </Style>
                        <Style Selector="TextBlock.wrong">
                            <Setter Property="Foreground" Value="#FF5C5C" />
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
            </Grid>

            <!-- UNTERER BEREICH: Wort- / Mathe-Feier-Banner & Falsch-Feedback -->
            <Grid Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0">
                <!-- ERFOLG -->
                <Border Background="#2A2212"
                        BorderBrush="#FFD166"
                        BorderThickness="2"
                        CornerRadius="16"
                        Padding="24,12"
                        IsVisible="{Binding IsWordCelebrationActive}">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="⭐" FontSize="30" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CelebratedWord}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#FFD166"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="⭐" FontSize="30" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- FEHLER / NOCHMAL PROBIEREN -->
                <Border Background="#2A1414"
                        BorderBrush="#FF5C5C"
                        BorderThickness="2"
                        CornerRadius="16"
                        Padding="24,12"
                        IsVisible="{Binding IsWrongFeedbackActive}">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="28" VerticalAlignment="Center" />
                        <TextBlock Text="Fast richtig! Probier es gleich nochmal."
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#FF8888"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- BÜHNE 2: ELTERN-PORTAL OVERLAY (VERSTECKTES MENÜ)        -->
        <!-- ========================================================= -->
        <Grid Background="#E60A0B0E"
              IsVisible="{Binding IsParentOverlayVisible}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- PIN EINGABE -->
            <Border Background="#1C1E26"
                    BorderBrush="#2E3242"
                    BorderThickness="2"
                    CornerRadius="20"
                    Padding="36"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !ParentMenu.IsAuthenticated}">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="🛡️ Eltern-Bereich"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#F5F4EE"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Bitte PIN eingeben (Standard: 1337)"
                                   FontSize="15"
                                   Foreground="#8C90A0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBox Text="{Binding ParentMenu.PinInput}"
                             PasswordChar="•"
                             FontSize="32"
                             TextAlignment="Center"
                             Background="#121318"
                             Foreground="#F5F4EE"
                             BorderBrush="#3D4255"
                             CornerRadius="10"
                             Padding="10"
                             MaxLength="8" />

                    <TextBlock Text="{Binding ParentMenu.PinErrorMessage}"
                               Foreground="#FF5C5C"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding ParentMenu.PinErrorMessage.Length}" />

                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Content="Abbrechen"
                                Command="{Binding ToggleParentOverlay}"
                                Background="#2A2C38"
                                Foreground="#F5F4EE"
                                CornerRadius="8"
                                Padding="16,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Content="Entsperren"
                                Command="{Binding ParentMenu.SubmitPinCommand}"
                                Background="#3A7AF0"
                                Foreground="White"
                                FontWeight="Bold"
                                CornerRadius="8"
                                Padding="16,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ELTERN DASHBOARD -->
            <Border Background="#1A1C24"
                    BorderBrush="#2E3242"
                    BorderThickness="2"
                    CornerRadius="20"
                    Padding="32"
                    Width="740"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ParentMenu.IsAuthenticated}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="⚙️ BuchstabenOS Einstellungen"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#F5F4EE" />
                                <TextBlock Text="Konfiguration &amp; Systemverwaltung für Moritz' Laptop"
                                           FontSize="13"
                                           Foreground="#8C90A0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕ Schließen"
                                    Command="{Binding ParentMenu.CloseMenuCommand}"
                                    Background="#2A2C38"
                                    Foreground="#F5F4EE"
                                    CornerRadius="8"
                                    Padding="12,6" />
                        </Grid>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- 1. Audio & Sprachmodus -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="🔊 Audio &amp; Sprache"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#FFD166" />

                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Lautstärke: " VerticalAlignment="Center" Foreground="#C5C7D0" />
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding ParentMenu.Volume}"
                                        Margin="16,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ParentMenu.Volume, StringFormat='{}{0}%'}"
                                           VerticalAlignment="Center"
                                           Foreground="#F5F4EE"
                                           FontWeight="Bold"
                                           Width="45" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,*" Margin="0,8,0,0">
                                <TextBlock Grid.Column="0" Text="Sprach-Modus: " VerticalAlignment="Center" Foreground="#C5C7D0" Margin="0,0,16,0" />
                                <Button Grid.Column="1"
                                        Content="Lautieren (M, A, P)"
                                        Command="{Binding ParentMenu.SetSpeechModeCommand}"
                                        CommandParameter="Phonetic"
                                        Classes.active="{Binding ParentMenu.IsPhoneticSpeechMode}"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Button.Styles>
                                        <Style Selector="Button.active">
                                            <Setter Property="Background" Value="#3A7AF0" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <Button Grid.Column="2"
                                        Content="Alphabet (Em, Ah, Pe)"
                                        Command="{Binding ParentMenu.SetSpeechModeCommand}"
                                        CommandParameter="Alphabet"
                                        Classes.active="{Binding !ParentMenu.IsPhoneticSpeechMode}"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="8,0,0,0">
                                    <Button.Styles>
                                        <Style Selector="Button.active">
                                            <Setter Property="Background" Value="#3A7AF0" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- 2. Wörterbuch (Scope pro Spiel) -->
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="📚 Wörterbuch (Spiel: Buchstaben-Zauber)"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#FFD166" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ParentMenu.GameWords.Count, StringFormat='{}{0} Wörter'}"
                                           Foreground="#8C90A0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Neues Wort hinzufügen -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ParentMenu.NewWordInput}"
                                         Watermark="Neues Wort eingeben (z.B. BAGGER, OMA, REX)..."
                                         Background="#121318"
                                         Foreground="#F5F4EE"
                                         BorderBrush="#3D4255"
                                         CornerRadius="8"
                                         Padding="10,8"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="+ Hinzufügen"
                                        Command="{Binding ParentMenu.AddWordCommand}"
                                        Background="#2ECC71"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        CornerRadius="8"
                                        Padding="16,8" />
                            </Grid>

                            <!-- Statusmeldung -->
                            <TextBlock Text="{Binding ParentMenu.StatusNotification}"
                                       Foreground="#2ECC71"
                                       FontSize="13"
                                       IsVisible="{Binding ParentMenu.StatusNotification.Length}" />

                            <!-- Liste der Wörter als Tags -->
                            <Border Background="#121318"
                                    BorderBrush="#2E3242"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    MaxHeight="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ParentMenu.GameWords}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#252834"
                                                        CornerRadius="6"
                                                        Padding="8,4"
                                                        Margin="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding}" Foreground="#F5F4EE" VerticalAlignment="Center" />
                                                        <Button Content="✕"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ParentMenu.RemoveWordCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                Foreground="#FF7B7B"
                                                                Padding="2,0"
                                                                FontSize="11" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- 3. Spiele & Moderation -->
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="🎮 Spiele &amp; Moderation"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#FFD166" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ParentMenu.ActiveGameId, StringFormat='Aktiv: {0}'}"
                                           Foreground="#8C90A0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Manuelles Umschalten -->
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0"
                                        Content="🔤 Buchstaben-Zauber"
                                        Command="{Binding ParentMenu.SwitchActiveGameCommand}"
                                        CommandParameter="free-typing"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Content="➕ Mathe-Zwerg (Addition)"
                                        Command="{Binding ParentMenu.SwitchActiveGameCommand}"
                                        CommandParameter="math-addition"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="6,0,0,0" />
                            </Grid>

                            <!-- Automatischer Spielewechsel Toggle -->
                            <CheckBox IsChecked="{Binding ParentMenu.AutoGameSwitching}"
                                      Content="Automatischer Spielewechsel (Aufmerksamkeits-Würfel aktivieren)"
                                      Foreground="#F5F4EE" />

                            <!-- Mathe-Konfiguration: Rechnen bis -->
                            <Border Background="#121318" BorderBrush="#2E3242" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="➕ Mathespiel: Rechnen bis (Maximales Ergebnis)"
                                               FontWeight="Bold"
                                               Foreground="#E5E4DC" />

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Max. Summe: " Foreground="#8C90A0" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Minimum="2"
                                                Maximum="20"
                                                Value="{Binding ParentMenu.MathMaxSum}"
                                                Margin="16,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ParentMenu.MathMaxSum, StringFormat='bis {0}'}"
                                                   Foreground="#FFD166"
                                                   FontWeight="Bold"
                                                   Width="50"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Separator Background="#252834" Height="1" />

                                    <!-- Gewichtung -->
                                    <TextBlock Text="🎲 Würfel-Gewichtung bei automatischem Wechsel:"
                                               FontSize="13"
                                               Foreground="#8C90A0" />

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ParentMenu.TypingWeight, StringFormat='Buchstaben: {0}%'}" Foreground="#C5C7D0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding ParentMenu.TypingWeight}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ParentMenu.MathWeight, StringFormat='Mathe: {0}%'}" Foreground="#C5C7D0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding ParentMenu.MathWeight}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Einstellungen speichern Button -->
                                    <Button Content="💾 Spiele-Einstellungen speichern"
                                            Command="{Binding ParentMenu.SaveGameSettingsCommand}"
                                            Background="#2ECC71"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            CornerRadius="8"
                                            Padding="14,8"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Separator Background="#2E3242" Height="1" />

                        <!-- 4. Systemaktionen -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="💻 System-Steuerung (Linux)"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#FFD166" />

                            <Grid ColumnDefinitions="*,*,*">
                                <Button Grid.Column="0"
                                        Content="🖥️ Desktop freigeben"
                                        Command="{Binding ParentMenu.ExitToDesktopCommand}"
                                        Background="#2A2C38"
                                        Foreground="#F5F4EE"
                                        CornerRadius="8"
                                        Padding="12,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Content="🔄 Laptop Neustarten"
                                        Command="{Binding ParentMenu.RebootCommand}"
                                        Background="#2A2C38"
                                        Foreground="#F5F4EE"
                                        CornerRadius="8"
                                        Padding="12,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="6,0,6,0" />
                                <Button Grid.Column="2"
                                        Content="⏻ Laptop Ausschalten"
                                        Command="{Binding ParentMenu.PowerOffCommand}"
                                        Background="#C0392B"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        CornerRadius="8"
                                        Padding="12,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
